Fix GPU spike on resolution change: clear the dirty flag only after the
render completes, so a resize event arriving mid-render does not drop a
frame or trigger a duplicate render burst.

Rebased onto the UTM venus cocoa GL stack (gl_dirty/cocoa_gl_render).

--- a/ui/cocoa.m
+++ b/ui/cocoa.m
@@ -2343,6 +2343,7 @@ static void cocoa_gl_render(void)
         glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, filter);
         surface_gl_render_texture(dgc.gls, surface);
     }
+    gl_dirty = false;
 }

 static void cocoa_gl_refresh(DisplayChangeListener *dcl)
@@ -2351,7 +2352,6 @@ static void cocoa_gl_refresh(DisplayChangeListener *dcl)
     cocoa_refresh(dcl);

     if (gl_dirty) {
-        gl_dirty = false;

 #ifdef CONFIG_EGL
 #ifdef USE_METAL
